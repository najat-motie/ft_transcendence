{
  default_sni {$CADDY_HOST:localhost}
}

localhost, {$CADDY_HOST:localhost} {
  tls internal

  handle /api/refresh {
    rewrite * /auth/refresh
    reverse_proxy backend:3000
  }

  handle_path /api/* {
    reverse_proxy backend:3000
  }

  handle /uploads/* {
    reverse_proxy backend:3000
  }

  handle /ws/* {
    reverse_proxy backend:3000
  }

  handle /health {
    reverse_proxy backend:3000
  }

  handle {
    reverse_proxy frontend:5173
  }
}
