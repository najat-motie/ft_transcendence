### ============================================
### TIC TAC TOE PLATFORM - COMPREHENSIVE TEST SUITE
### ============================================
### All routes use correct paths (NO /api prefix)
### Complete end-to-end test flow from registration to friendship

@baseUrl = http://localhost:3000
@aliceAccessToken = 
@aliceRefreshToken = 
@aliceUserId = 
@bobAccessToken = 
@bobRefreshToken = 
@bobUserId = 
@friendRequestId = 

### ============================================
### HEALTH CHECK
### ============================================
GET {{baseUrl}}/health

### ============================================
### STEP 1: USER ALICE - REGISTRATION
### ============================================
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "TestPassword123"
}

### ============================================
### STEP 2: USER ALICE - LOGIN
### Save: aliceAccessToken, aliceRefreshToken, aliceUserId
### ============================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "TestPassword123"
}

### ============================================
### STEP 3: USER ALICE - CREATE PROFILE
### ============================================
POST {{baseUrl}}/profile
Authorization: Bearer {{aliceAccessToken}}
Content-Type: application/json

{
  "username": "alice_user",
  "bio": "Hi, I'm Alice!",
  "avatar": "https://example.com/alice-avatar.jpg"
}

### ============================================
### STEP 4: GET ALICE'S PROFILE
### ============================================
GET {{baseUrl}}/profile/{{aliceUserId}}
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### STEP 5: GET ALICE'S PROFILE KPIs
### ============================================
GET {{baseUrl}}/profile/{{aliceUserId}}/kpis
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### STEP 6: UPDATE ALICE'S PROFILE
### ============================================
PUT {{baseUrl}}/profile
Authorization: Bearer {{aliceAccessToken}}
Content-Type: application/json

{
  "bio": "Updated bio from Alice",
  "avatar": "https://example.com/alice-new-avatar.jpg"
}

### ============================================
### STEP 7: USER BOB - REGISTRATION
### ============================================
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "bob@example.com",
  "password": "TestPassword123"
}

### ============================================
### STEP 8: USER BOB - LOGIN
### Save: bobAccessToken, bobRefreshToken, bobUserId
### ============================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bob@example.com",
  "password": "TestPassword123"
}

### ============================================
### STEP 9: USER BOB - CREATE PROFILE
### ============================================
POST {{baseUrl}}/profile
Authorization: Bearer {{bobAccessToken}}
Content-Type: application/json

{
  "username": "bob_user",
  "bio": "Hey, I'm Bob!",
  "avatar": "https://example.com/bob-avatar.jpg"
}

### ============================================
### STEP 10: GET BOB'S PROFILE
### ============================================
GET {{baseUrl}}/profile/{{bobUserId}}
Authorization: Bearer {{bobAccessToken}}

### ============================================
### STEP 11: SEARCH FOR USERS (ALICE searches for BOB)
### ============================================
GET {{baseUrl}}/users/search?q=bob
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### STEP 12: SEARCH FOR USERS BY EMAIL
### ============================================
GET {{baseUrl}}/users/search?q=bob@example.com
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### STEP 13: ALICE SENDS FRIEND REQUEST TO BOB
### Save: friendRequestId from response.data.id
### ============================================
POST {{baseUrl}}/friends/request/{{bobUserId}}
Authorization: Bearer {{aliceAccessToken}}
Content-Type: application/json

{
  "message": "Hey Bob, let's be friends!"
}

### ============================================
### STEP 14: BOB VIEWS PENDING FRIEND REQUESTS
### ============================================
GET {{baseUrl}}/friends/requests
Authorization: Bearer {{bobAccessToken}}

### ============================================
### STEP 15: BOB ACCEPTS ALICE'S FRIEND REQUEST
### ============================================
POST {{baseUrl}}/friends/accept/{{friendRequestId}}
Authorization: Bearer {{bobAccessToken}}
Content-Type: application/json

{
}

### ============================================
### STEP 16: GET ALICE'S FRIENDS LIST
### ============================================
GET {{baseUrl}}/friends
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### STEP 17: GET BOB'S FRIENDS LIST
### ============================================
GET {{baseUrl}}/friends
Authorization: Bearer {{bobAccessToken}}

### ============================================
### STEP 18: CHECK FRIENDSHIP STATUS (ALICE checking BOB)
### ============================================
GET {{baseUrl}}/friends/check/{{bobUserId}}
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### STEP 19: CHECK FRIENDSHIP STATUS (BOB checking ALICE)
### ============================================
GET {{baseUrl}}/friends/check/{{aliceUserId}}
Authorization: Bearer {{bobAccessToken}}

### ============================================
### TEST: PAGINATION IN FRIENDS LIST
### ============================================
GET {{baseUrl}}/friends?limit=10&offset=0
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### TEST: CREATE THIRD USER FOR ADDITIONAL REQUESTS
### ============================================
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "charlie@example.com",
  "password": "TestPassword123"
}

### ============================================
### TEST: CHARLIE LOGIN
### ============================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "charlie@example.com",
  "password": "TestPassword123"
}

### ============================================
### TEST: CHARLIE CREATE PROFILE
### ============================================
POST {{baseUrl}}/profile
Authorization: Bearer {{aliceAccessToken}}
Content-Type: application/json

{
  "username": "charlie_user",
  "bio": "Hi, I'm Charlie!"
}

### ============================================
### TEST: ALICE SENDS ANOTHER FRIEND REQUEST (to get requestId for reject test)
### Save this requestId for rejection test
### ============================================
POST {{baseUrl}}/friends/request/{{aliceUserId}}
Authorization: Bearer {{bobAccessToken}}
Content-Type: application/json

{
  "message": "Can we be friends again?"
}

### ============================================
### TEST: ALICE REJECTS FRIEND REQUEST
### ============================================
POST {{baseUrl}}/friends/reject/{{friendRequestId}}
Authorization: Bearer {{aliceAccessToken}}
Content-Type: application/json

{
}

### ============================================
### TEST: REMOVE FRIEND (ALICE removes BOB)
### ============================================
DELETE {{baseUrl}}/friends/{{bobUserId}}
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### TEST: VERIFY FRIENDSHIP REMOVED
### ============================================
GET {{baseUrl}}/friends/check/{{bobUserId}}
Authorization: Bearer {{aliceAccessToken}}

### ============================================
### ERROR CASES TESTING
### ============================================

### TEST: Login with invalid password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "WrongPassword"
}

### TEST: Register duplicate email
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "TestPassword123"
}

### TEST: Send friend request to self (should fail)
POST {{baseUrl}}/friends/request/{{aliceUserId}}
Authorization: Bearer {{aliceAccessToken}}
Content-Type: application/json

{
}

### TEST: Send friend request without authentication
POST {{baseUrl}}/friends/request/{{bobUserId}}
Content-Type: application/json

{
}

### TEST: Search without query parameter
GET {{baseUrl}}/users/search
Authorization: Bearer {{aliceAccessToken}}

### TEST: Access protected endpoint without token
GET {{baseUrl}}/friends

